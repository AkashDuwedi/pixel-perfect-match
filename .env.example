# Vedaalay — environment variables (client-side, safe to expose)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Alias used by the managed Supabase integration in this project.
# Set it to the same value as VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# NEVER put SUPABASE_SERVICE_ROLE_KEY in a VITE_ variable — it must stay server-side.
